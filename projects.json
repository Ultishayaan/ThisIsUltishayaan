{
  "scan_root": "~/PycharmProjects",
  "hub_port": 7777,
  "auto_start": false,
  "projects": {
    "AskAExpert": {
      "enabled": true,
      "type": "node",
      "path": "~/PycharmProjects/AskAExpert",
      "description": "Teacher-Student Q&A real-time app with Socket.IO and AI cheat answers",
      "icon": "AA",
      "color": "#3b82f6",
      "command": "npm start",
      "cwd": "~/PycharmProjects/AskAExpert",
      "port": 3000,
      "url": "http://localhost:3000/teacher.html",
      "entry": "public/teacher.html",
      "extra_entry": "public/student.html",
      "env": {},
      "tags": [
        "education",
        "realtime",
        "socket.io",
        "ai"
      ]
    },
    "Minceraft+": {
      "enabled": true,
      "type": "node",
      "path": "~/PycharmProjects/Minceraft+",
      "description": "GameHub LAN - Among Us, Minecraft, and party games with Socket.IO",
      "icon": "MC",
      "color": "#f97316",
      "command": "npm start",
      "cwd": "~/PycharmProjects/Minceraft+/game-server",
      "port": 3001,
      "url": "http://localhost:3001/",
      "entry": "game-server/public/index.html",
      "env": {
        "PORT": "3001"
      },
      "tags": [
        "games",
        "lan",
        "socket.io",
        "multiplayer"
      ]
    }
  }
}